IAM_BOOTSTRAP_TOKEN=replace-in-shared-environments
IAM_ISSUER=http://localhost:8010
IAM_TOKEN_TTL_SECONDS=300
IAM_SIGNING_KEY_ID=local-dev
# Platform Access Token: срок по умолчанию 30 дней, потолок — год.
IAM_PAT_DEFAULT_TTL_SECONDS=2592000
IAM_PAT_MAX_TTL_SECONDS=31536000
# Насколько свежим должен быть human authentication на момент выпуска PAT.
IAM_PAT_MAX_AUTHENTICATION_AGE_SECONDS=300
# Предельное окно совместимости для перенесённых Control Plane API keys.
IAM_LEGACY_CREDENTIAL_MAX_TTL_SECONDS=7776000
